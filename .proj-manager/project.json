{
 "project_name": "ElementGroups",
 "version": "1.3.0",
 "created_at": "2026-02-23T00:00:00Z",
 "last_updated": "2026-08-10T05:40:00Z",
 "agent_version": "1.0.0",
 "project_type": "fullstack",
 "framework": {
  "backend": "Flask",
  "frontend": "Vue 3 + Vite"
 },
 "languages": [
  "Python",
  "JavaScript"
 ],
 "entry_points": [
  "backend/run.py",
  "frontend/src/main.js"
 ],
 "config_files": [
  "backend/.env",
  "backend/.env.example",
  "backend/app/config.py",
  "frontend/vite.config.js",
  "frontend/vite-plugin-seo.js",
  "frontend/.env.production",
  "frontend/package.json",
  "frontend/.dockerignore",
  "backend/.dockerignore",
  "render.yaml"
 ],
 "git_initialized": true,
 "team_size": 1,
 "metadata": {
  "description": "元素週期表分組應用，提供元素資訊、分組管理與視覺化功能。後端使用 Flask + Firebase Realtime DB + Firebase Auth，前端使用 Vue 3 + ECharts",
  "repository": "https://github.com/Pin-Ying/ElementGroups",
  "deployment": {
   "current": "Render.com",
   "frontend": {
    "type": "static site",
    "url": "https://elementgroups-frontend.onrender.com",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "note": "VITE_API_URL 由 Render 環境變數注入，覆蓋 repo 內的 .env.production"
   },
   "backend": {
    "type": "web service",
    "url": "https://elementtable.onrender.com",
    "note": "與前端同一個 repo，push 後兩者皆自動重新部署"
   },
   "local": "docker-compose（前端 8080、後端 8000；需 backend/.env 的 Firebase 憑證）"
  },
  "database": {
   "type": "Firebase Realtime Database",
   "removed": "SQLite / SQLAlchemy"
  },
  "gunicorn_workers": 1,
  "notes": "workers=1 因 Flask-Login 使用 in-memory users dict，多 worker 導致 session 401",
  "env_variables": {
   "required": [
    "SECRET_KEY",
    "FIREBASE_*"
   ],
   "optional": [
    "FIREBASE_STORAGE_ENABLED",
    "AI_PROVIDER",
    "AI_API_KEY",
    "AI_MODEL",
    "AI_DAILY_LIMIT",
    "AI_MAX_OUTPUT_TOKENS",
    "VITE_SITE_URL"
   ]
  }
 }
}