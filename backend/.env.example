# Flask
SECRET_KEY=your-secret-key-here
PORT=8000

# Firebase Admin SDK (Service Account)
FIREBASE_PROJECT_ID=elementgroups-168e4
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-yvao5@elementgroups-168e4.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=104901293045646212187
FIREBASE_STORAGE_BUCKET=elementgroups-168e4.appspot.com
# 升級 Blaze 付費方案後可設為 true 啟用 GCS 圖片儲存；預設 false 只用 Realtime DB base64（img_data）
FIREBASE_STORAGE_ENABLED=false
FIREBASE_DATABASE_URL=https://elementgroups-168e4-default-rtdb.firebaseio.com/

# Firebase Client (Pyrebase)
# 允許登入後台的帳號，逗號分隔，可填 UID 或 email。
# 留空＝任何在這個 Firebase 專案裡有效的帳號都能進後台（會印警告）。
# 用 `python scripts/list_auth_users.py` 查自己的 UID。
ADMIN_ACCOUNTS=

# ── 用 Google 帳號登入後台（選用）──
# 預設 false。改成 true 之前，Firebase 主控台要先做完三件事：
#   1. Authentication → Sign-in method → 啟用 Google 供應商
#   2. Authentication → Settings → 授權網域加入 Render 的前端網域
#      （最容易漏掉，漏了線上按下去會被擋，錯誤訊息不會說是這個原因）
#   3. 確認上面的 ADMIN_ACCOUNTS 已經填好 ← 最重要
#
# 第 3 點沒做就開啟，後台會比現在更不安全：任何 Google 帳號都能完成
# 登入流程，擋下來的是 ADMIN_ACCOUNTS，不是 Google。
GOOGLE_LOGIN_ENABLED=false

FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=elementgroups-168e4.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=250522275933
FIREBASE_APP_ID=1:250522275933:web:8a94be47e0536b78193db4
FIREBASE_MEASUREMENT_ID=G-V4VVDNKTN1

# ── AI 故事協助（選用）──
# 不填 AI_API_KEY 就完全不啟用，Admin 也不會出現 AI 相關按鈕。
#
# Gemini API key 申請方式（免費，不需信用卡）：
#   1. 用 Google 帳號登入 https://aistudio.google.com/
#   2. 左側或右上角點「Get API key」→「Create API key」
#   3. 選一個 Google Cloud 專案（沒有的話它會幫你建）
#   4. 複製產生的金鑰，填到下面的 AI_API_KEY
#   免費層有每分鐘與每日的請求上限，實際額度以官方頁面為準。
#
# 部署在 Render 時，請到該服務的 Environment 分頁新增這些變數，
# 不要寫進 repo。
AI_PROVIDER=gemini
AI_API_KEY=
# 可換成其他 Gemini 模型，例如 gemini-flash-lite-latest（更省額度）。
# 舊型號會退役，退役後 API 直接回 404；-latest 會自動跟著走，要固定版本
# 就填明確的型號（例如 gemini-3.6-flash）。可用清單：
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=你的KEY"
AI_MODEL=gemini-flash-latest
# 每日呼叫次數上限，避免不小心把免費額度用光；設 0 表示不限制
AI_DAILY_LIMIT=50
# 單次輸出的 token 上限。思考型模型會先花掉一部分
# 預算在思考上，設太低會讓正文被截斷
AI_MAX_OUTPUT_TOKENS=4096
